<Window
    x:Class="FlatFileList.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FlatFileList.Behaviors"
    xmlns:converters="clr-namespace:FlatFileList.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="clr-namespace:FlatFileList.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:FlatFileList"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="{Binding Title.Value}"
    Width="1000"
    Height="600"
    d:DataContext="{d:DesignInstance local:MainWindowViewModelDesignMode,
                                     IsDesignTimeCreatable=True}"
    FocusManager.FocusedElement="{Binding ElementName=TextBoxSearchDirectoryPath}"
    mc:Ignorable="d">
    <Window.Resources>
        <local:BindingProxy x:Key="proxy" Data="{Binding}" />
        <local:BindingProxy x:Key="FileListProxy" Data="{Binding ElementName=FileList}" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:ComparisonConverter x:Key="ComparisonConverter" />
        <converters:DatetimeConverter x:Key="DatetimeConverter" />
        <sys:Double x:Key="FileIconImageMaxSize">20</sys:Double>
        <sys:Int32 x:Key="ToolTipInitialShowDelay">200</sys:Int32>
        <GridLength x:Key="ImageButtonGridWidth">16</GridLength>
        <sys:Double x:Key="ButtonSize">16</sys:Double>
        <sys:Double x:Key="ButtonIconSize">14</sys:Double>
        <!--  1ボタン + 1ピクセル  -->
        <Thickness x:Key="OneButtonPadding">0,0,17,0</Thickness>
        <!--  2ボタン + 1ピクセル  -->
        <Thickness x:Key="TwoButtonPadding">0,0,33,0</Thickness>
        <Style x:Key="PackIconButtonStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="{StaticResource ButtonIconSize}" />
            <Setter Property="Height" Value="{StaticResource ButtonIconSize}" />
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!--  独自テンプレートで BasedOn していないため、Fluent のテーマ対応前景色を明示指定（ダーク=白 / ライト=黒）。PackIcon がこれを継承する。  -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="{StaticResource ToolTipInitialShowDelay}" />
            <Setter Property="Width" Value="{StaticResource ButtonSize}" />
            <Setter Property="Height" Value="{StaticResource ButtonSize}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="true">
                            <ContentPresenter
                                x:Name="contentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Focusable="False"
                                RecognizesAccessKey="True" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

                                <!--<Setter TargetName="border" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />-->
                                <Setter TargetName="border" Property="Background" Value="Transparent" />

                                <Setter TargetName="border" Property="Opacity" Value="0.56" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="IconToggleButtonStyle"
            BasedOn="{StaticResource {x:Type ToggleButton}}"
            TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="{StaticResource ToolTipInitialShowDelay}" />
            <Setter Property="Width" Value="{StaticResource ButtonSize}" />
            <Setter Property="Height" Value="{StaticResource ButtonSize}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="IconToggleRadioButtonStyle"
            BasedOn="{StaticResource IconToggleButtonStyle}"
            TargetType="RadioButton">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style
            x:Key="GroupBoxStyle"
            BasedOn="{StaticResource DefaultGroupBoxStyle}"
            TargetType="GroupBox">
            <!--  Fluent は暗黙の {x:Type GroupBox} を登録しないため、名前付きキー DefaultGroupBoxStyle を継承する。  -->
            <!--  Fluent 既定の枠はダークでほぼ不可視のため、テーマ対応の可視ストロークを明示してカード然とさせる。  -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type ToolTip}}" TargetType="ToolTip">
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="{Binding Data.WindowScale.Value, Source={StaticResource proxy}}" ScaleY="{Binding Data.WindowScale.Value, Source={StaticResource proxy}}" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style BasedOn="{StaticResource {x:Type ContextMenu}}" TargetType="ContextMenu">
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="{Binding Data.WindowScale.Value, Source={StaticResource proxy}}" ScaleY="{Binding Data.WindowScale.Value, Source={StaticResource proxy}}" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="CopyToColipboardFileNamesMenuItemStyle"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="Header" Value="ファイル名をコピー" />
            <Setter Property="Command" Value="{Binding Data.CopyToColipboardFileNames, Source={StaticResource proxy}}" />
            <Setter Property="CommandParameter" Value="{Binding Data.SelectedItems, Source={StaticResource FileListProxy}}" />
            <Setter Property="Icon">
                <Setter.Value>
                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="ClipboardTextMultipleOutline" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="CopyToColipboardRelativeFilePathsMenuItemStyle"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="Header" Value="ファイルの相対パスをコピー" />
            <Setter Property="Command" Value="{Binding Data.CopyToColipboardRelativeFilePaths, Source={StaticResource proxy}}" />
            <Setter Property="CommandParameter" Value="{Binding Data.SelectedItems, Source={StaticResource FileListProxy}}" />
            <Setter Property="Icon">
                <Setter.Value>
                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="ClipboardTextMultipleOutline" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="CopyToColipboardAbsoluteFilePathsMenuItemStyle"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="Header" Value="ファイルの絶対パスをコピー" />
            <Setter Property="Command" Value="{Binding Data.CopyToColipboardAbsoluteFilePaths, Source={StaticResource proxy}}" />
            <Setter Property="CommandParameter" Value="{Binding Data.SelectedItems, Source={StaticResource FileListProxy}}" />
            <Setter Property="Icon">
                <Setter.Value>
                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="ClipboardTextMultipleOutline" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="OpenFilesMenuItemStyle"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="Header" Value="ファイルを開く" />
            <Setter Property="Command" Value="{Binding Data.OpenFiles, Source={StaticResource proxy}}" />
            <Setter Property="CommandParameter" Value="{Binding Data.SelectedItems, Source={StaticResource FileListProxy}}" />
            <Setter Property="Icon">
                <Setter.Value>
                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="OpenInApp" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="CopyToColipboardDirectoryNameMenuItemStyle"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="Header" Value="フォルダー名をコピー" />
            <Setter Property="Command" Value="{Binding Data.CopyToColipboardSingleText, Source={StaticResource proxy}}" />
            <Setter Property="CommandParameter" Value="{Binding Name}" />
            <Setter Property="Icon">
                <Setter.Value>
                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="ClipboardTextOutline" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="CopyToColipboardRelativeDirectoryNameMenuItemStyle"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="Header" Value="フォルダーの相対パスをコピー" />
            <Setter Property="Command" Value="{Binding Data.CopyToColipboardSingleText, Source={StaticResource proxy}}" />
            <Setter Property="CommandParameter" Value="{Binding RelativePath}" />
            <Setter Property="Icon">
                <Setter.Value>
                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="ClipboardTextOutline" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="CopyToColipboardAbsoluteDirectoryNameMenuItemStyle"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="Header" Value="フォルダーの絶対パスをコピー" />
            <Setter Property="Command" Value="{Binding Data.CopyToColipboardSingleText, Source={StaticResource proxy}}" />
            <Setter Property="CommandParameter" Value="{Binding TargetPath}" />
            <Setter Property="Icon">
                <Setter.Value>
                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="ClipboardTextOutline" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="ShowFileProperties"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="Header" Value="プロパティ" />
            <Setter Property="Command" Value="{Binding Data.ShowFileProperties, Source={StaticResource proxy}}" />
            <Setter Property="CommandParameter" Value="{Binding Data.SelectedItems, Source={StaticResource FileListProxy}}" />
            <Setter Property="Icon">
                <Setter.Value>
                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="WrenchOutline" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="ShowDirectoryProperties"
            BasedOn="{StaticResource {x:Type MenuItem}}"
            TargetType="MenuItem">
            <Setter Property="Header" Value="プロパティ" />
            <Setter Property="Command" Value="{Binding Data.ShowDirectoryProperties, Source={StaticResource proxy}}" />
            <Setter Property="CommandParameter" Value="{Binding AbsolutePath}" />
            <Setter Property="Icon">
                <Setter.Value>
                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="FolderWrenchOutline" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="OpenDirectoryButtonStyle"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Command" Value="{Binding Data.OpenDirectory, Source={StaticResource proxy}}" />
            <Setter Property="CommandParameter" Value="{Binding TargetPath}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled, TargetNullValue=false, FallbackValue=False}" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow, Mode=FindAncestor}, Path=IsSelected}" Value="True">
                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridCell}}" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridCell}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <i:Interaction.Behaviors>
        <behaviors:WindowClosingBehavior />
    </i:Interaction.Behaviors>
    <Window.InputBindings>
        <KeyBinding
            Key="S"
            Command="{Binding Search}"
            Modifiers="Ctrl" />
    </Window.InputBindings>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding WindowProgressState.Value}" ProgressValue="{Binding ProgressPer.Value}" />
    </Window.TaskbarItemInfo>
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding WindowScale.Value}" ScaleY="{Binding WindowScale.Value}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsEnabled="{Binding IsSearching.Value, Converter={StaticResource InvertedBoolConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer
                Grid.Row="0"
                Grid.Column="0"
                Padding="0,0,12,0"
                HorizontalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
                <Grid HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" MinHeight="150" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <GroupBox
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource GroupBoxStyle}">
                        <GroupBox.Header>
                            <TextBlock Text="検索条件" ToolTipService.InitialShowDelay="{StaticResource ToolTipInitialShowDelay}">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                                            以下を設定し検索ボタンをクリックし、ファイルを一覧に表示する。<LineBreak />
                                            ・一覧を表示するフォルダーのフルパス<LineBreak />
                                            ・検索後、取得しないプロパティ<LineBreak />
                                            ・検索時、ファイル取得対象外とする条件</TextBlock>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" SharedSizeGroup="label" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" SharedSizeGroup="action1" />
                                <ColumnDefinition SharedSizeGroup="action1" />
                                <ColumnDefinition Width="1" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" SharedSizeGroup="SearchRowHeight" />
                                <RowDefinition Height="auto" SharedSizeGroup="SearchRowHeight" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" SharedSizeGroup="SearchRowHeight" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="フォルダーパス" />
                            <TextBox
                                x:Name="TextBoxSearchDirectoryPath"
                                Grid.Row="0"
                                Grid.Column="1"
                                Grid.ColumnSpan="4"
                                Padding="{StaticResource TwoButtonPadding}"
                                HorizontalAlignment="Stretch"
                                x:FieldModifier="private"
                                IsEnabled="{Binding ExistsFileLists.Value, Converter={StaticResource InvertedBoolConverter}}"
                                Text="{Binding DirectoryPath.Value, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Behaviors>
                                    <behaviors:TextBoxBehavior x:Name="TextBoxSearchDirectoryPathBehavior" />
                                </i:Interaction.Behaviors>
                            </TextBox>
                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                IsEnabled="{Binding ExistsFileLists.Value, Converter={StaticResource InvertedBoolConverter}}"
                                Style="{StaticResource IconButtonStyle}">
                                <Button.ToolTip>
                                    <ToolTip Content="フォルダを開く" />
                                </Button.ToolTip>
                                <materialDesign:PackIcon Kind="FolderOpen" Style="{StaticResource PackIconButtonStyle}" />
                                <i:Interaction.Behaviors>
                                    <behaviors:FolderSelectBehavior SelectedPath="{Binding DirectoryPath.Value}" />
                                </i:Interaction.Behaviors>
                            </Button>
                            <Button
                                Grid.Row="0"
                                Grid.Column="3"
                                Style="{StaticResource IconButtonStyle}">
                                <Button.ToolTip>
                                    <ToolTip Content="テキストを削除する" />
                                </Button.ToolTip>
                                <materialDesign:PackIcon Kind="Clear" Style="{StaticResource PackIconButtonStyle}" />
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click">
                                        <i:InvokeCommandAction Command="{Binding ClearSearchResult}" />
                                        <i:CallMethodAction MethodName="Clear" TargetObject="{Binding ElementName=TextBoxSearchDirectoryPathBehavior}" />
                                        <i:CallMethodAction MethodName="Focus" TargetObject="{Binding ElementName=TextBoxSearchDirectoryPathBehavior}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="取得対象外" />
                            <CheckBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Content="前回保存日時"
                                IsChecked="{Binding IsIgnoreGettingLastSaveTime.Value}"
                                IsEnabled="{Binding ExistsFileLists.Value, Converter={StaticResource InvertedBoolConverter}}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="検索対象外" />
                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="4"
                                IsEnabled="{Binding ExistsFileLists.Value, Converter={StaticResource InvertedBoolConverter}}">
                                <WrapPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <CheckBox Content="隠しフォルダー" IsChecked="{Binding IsExcludeHiddenDirectory.Value}" />
                                    <CheckBox Content="システムフォルダー" IsChecked="{Binding IsExcludeSystemDirectory.Value}" />
                                    <CheckBox Content=".始まりのフォルダー" IsChecked="{Binding IsExcludeDotStartDirectory.Value}" />
                                </WrapPanel>
                                <WrapPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <CheckBox Content="隠しファイル" IsChecked="{Binding IsExcludeHiddenFile.Value}" />
                                    <CheckBox Content="システムファイル" IsChecked="{Binding IsExcludeSystemFile.Value}" />
                                    <CheckBox Content=".始まりのファイル" IsChecked="{Binding IsExcludeDotStartFile.Value}" />
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Text="対象外拡張子" />
                            <ItemsControl
                                Grid.Row="3"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                ItemsSource="{Binding ExcludeExtensions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,0,5,0"
                                            Text="{Binding ExtensionText}"
                                            Visibility="{Binding Enabled.Value, Converter={StaticResource BooleanToVisibility}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                x:Name="ExcludeExtensionEditButton"
                                Grid.Row="3"
                                Grid.Column="3"
                                BorderThickness="0"
                                IsEnabled="{Binding ExistsFileLists.Value, Converter={StaticResource InvertedBoolConverter}}">
                                <materialDesign:PackIcon Kind="LeadPencil" Style="{StaticResource PackIconButtonStyle}" />
                                <Button.Style>
                                    <Style BasedOn="{StaticResource IconButtonStyle}" TargetType="{x:Type Button}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ExcludeExtensionEditPopup, Path=IsOpen}" Value="True">
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click">
                                        <i:CallMethodAction MethodName="Open" TargetObject="{Binding ElementName=ExcludeExtensionEditPopupBehavior}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                            <Popup
                                x:Name="ExcludeExtensionEditPopup"
                                PlacementTarget="{Binding ElementName=ExcludeExtensionEditButton}"
                                StaysOpen="False">
                                <i:Interaction.Behaviors>
                                    <behaviors:PopupBehavior x:Name="ExcludeExtensionEditPopupBehavior" />
                                </i:Interaction.Behaviors>
                                <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="1">
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Text="拡張子" />
                                        <TextBox
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Padding="{StaticResource OneButtonPadding}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Text="{Binding ExcludeExtensionText.Value, UpdateSourceTrigger=PropertyChanged}">
                                            <i:Interaction.Behaviors>
                                                <behaviors:TextBoxBehavior x:Name="ExcludeExtensionTextBoxBehavior" />
                                            </i:Interaction.Behaviors>
                                        </TextBox>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Margin="0,0,1,0"
                                            Command="{Binding AddExcludeExtension}"
                                            Style="{StaticResource IconButtonStyle}">
                                            <materialDesign:PackIcon Kind="Add" Style="{StaticResource PackIconButtonStyle}" />
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:CallMethodAction MethodName="Focus" TargetObject="{Binding ElementName=ExcludeExtensionTextBoxBehavior}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                        </Button>
                                        <ScrollViewer
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalScrollBarVisibility="Hidden"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsControl
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                BorderThickness="0"
                                                ItemsSource="{Binding ExcludeExtensions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <CheckBox Content="{Binding ExtensionText}" IsChecked="{Binding Enabled.Value}" />
                                                            <Button Command="{Binding RemoveCommand}" Style="{StaticResource IconButtonStyle}">
                                                                <materialDesign:PackIcon Kind="Remove" Style="{StaticResource PackIconButtonStyle}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>

                            <Button
                                Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Command="{Binding Search}"
                                ToolTipService.InitialShowDelay="{StaticResource ToolTipInitialShowDelay}">
                                <Button.ToolTip>
                                    <ToolTip Content="検索する (Ctrl+S)" />
                                </Button.ToolTip>
                                <materialDesign:PackIcon Kind="Search" Style="{StaticResource PackIconButtonStyle}" />
                            </Button>
                        </Grid>
                    </GroupBox>
                    <GroupBox
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource GroupBoxStyle}">
                        <GroupBox.Header>
                            <TextBlock Text="フィルター条件" ToolTipService.InitialShowDelay="{StaticResource ToolTipInitialShowDelay}">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="検索後、表示されているファイル一覧に対して設定するフィルター文字列を設定する。" />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" SharedSizeGroup="label" />
                                <ColumnDefinition Width="*" />
