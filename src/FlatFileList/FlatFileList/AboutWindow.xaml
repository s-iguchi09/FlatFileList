<Window
    x:Class="FlatFileList.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FlatFileList.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="バージョン情報"
    Width="800"
    Height="520"
    MinWidth="560"
    MinHeight="400"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding WindowScale}" ScaleY="{Binding WindowScale}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ヘッダー: アプリ情報  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,12"
            Orientation="Horizontal">
            <materialDesign:PackIcon
                Width="48"
                Height="48"
                VerticalAlignment="Center"
                Kind="FileMultipleOutline" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="FlatFileList" />
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding VersionText}" />
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Copyright (c) 2026 s-iguchi09 - MIT License" />
            </StackPanel>
        </StackPanel>

        <!--  利用ライブラリのライセンス(左: 一覧 / 右: 全文)  -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,6"
                FontWeight="SemiBold"
                Text="ライセンス" />
            <ListBox
                Grid.Row="1"
                Grid.Column="0"
                ItemsSource="{Binding Licenses}"
                SelectedItem="{Binding SelectedLicense.Value}">
                <i:Interaction.Behaviors>
                    <behaviors:LineWheelScrollBehavior />
                </i:Interaction.Behaviors>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Version}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Margin="8,0,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <!--  App.xaml の暗黙スタイルが VerticalContentAlignment=Center のため Top を明示する。  -->
                <TextBox
                    Padding="8"
                    VerticalContentAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    IsReadOnly="True"
                    IsReadOnlyCaretVisible="False"
                    Text="{Binding SelectedLicense.Value.LicenseText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </Border>
        </Grid>

        <!--  閉じるボタン  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="88"
                Content="閉じる"
                IsCancel="True"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
